# Configuración para probar contra los emuladores de Firebase (npm run emulators + npm run dev:emu).
# Es un proyecto «demo-»: no existe en la nube y no hace falta ninguna credencial real.
VITE_USE_EMULATORS=1
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-pizarra.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-pizarra
VITE_FIREBASE_STORAGE_BUCKET=demo-pizarra.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:0
VITE_FIREBASE_DATABASE_URL=https://demo-pizarra-default-rtdb.firebaseio.com
